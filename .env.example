# Copy to .env.local. `npx convex dev` writes the two Convex values for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Same deployment, ending in .convex.site (the Better Auth HTTP routes live there)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the client IP the Next.js auth proxy passes to Convex (same value as the Convex env var)
AUTH_PROXY_SECRET=

# PostHog analytics. Leave both empty to turn PostHog off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
